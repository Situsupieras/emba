{
  "expo": {
    "name": "Inteligencia Prenatal",
    "slug": "inteligencia-prenatal",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inteligenciaprenatal.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.inteligenciaprenatal.app"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4A90E2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2b246150-ddb4-491d-a433-09fd2eef7b41"
      }
    },
    "owner": "alejandro220625",
    "scheme": "inteligenciaprenatal"
  }
}
